SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
KAWTEAM_WORKSPACE_ID=WORKSPACE_UUID_FROM_MIGRATION
KAWTEAM_DATABASE_SECRET=GENERATE_A_RANDOM_48_CHARACTER_SECRET
KAWTEAM_SESSION_SECRET=GENERATE_ANOTHER_RANDOM_48_CHARACTER_SECRET
KAWTEAM_GATEWAY_SECRET=SAME_RANDOM_SECRET_AS_WEB_GATEWAY
COOKIE_SECURE=false
TAVILY_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional Google Drive context (public API key OR folder-shared service account JSON)
GOOGLE_DRIVE_API_KEY=
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=

# Gmail: run the local Desktop OAuth consent command; all values stay server-side.
GMAIL_OAUTH_CLIENT_PATH=
GMAIL_TOKEN_PATH=
GMAIL_SENDER=
# Deployment alternative to a local token file (authorised-user JSON; secret).
GMAIL_AUTHORIZED_USER_JSON=
