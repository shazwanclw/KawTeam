# ──────────────────────────────────────────────────────
# KawTeam — Environment Variables
# Copy this file to .env and fill in your values.
# See docs/INTEGRATION_STATUS.md for setup details.
# ──────────────────────────────────────────────────────

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Workspace
KAWTEAM_WORKSPACE_ID=your-workspace-uuid

# Server secrets (min 32 characters each)
KAWTEAM_DATABASE_SECRET=
KAWTEAM_SESSION_SECRET=
KAWTEAM_GATEWAY_SECRET=

# AI providers
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
TAVILY_API_KEY=

# Google Drive (optional — for document memory)
GOOGLE_DRIVE_API_KEY=
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=

# Gmail (optional — for supplier outreach)
GMAIL_OAUTH_CLIENT_PATH=
GMAIL_TOKEN_PATH=
GMAIL_AUTHORIZED_USER_JSON=
GMAIL_SENDER=

# Cookie security (set true in production)
COOKIE_SECURE=false
